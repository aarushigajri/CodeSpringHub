# Conda environment (rebuild from environment.yml)
env/
# Runtime state: SQLite index, audit log, review tickets
var/
# Secrets never go in this folder (it is group-readable)
*.secret
.env
__pycache__/
*.egg-info/
.pytest_cache/

# Lab knowledge never goes to GitHub: only BSR's own knowledge and the workflow list do.
# Each pilot lab keeps its history in its own repository inside knowledge/<lab>/ (on /grid only).
knowledge/*/
!knowledge/bsr/
knowledge/*/members/
knowledge/*/_suggestions/
knowledge/roles.yaml
